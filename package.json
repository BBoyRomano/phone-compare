{
  "name": "phone-compare",
  "private": true,
  "description": "An evidence-led mobile phone comparison application.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "inventory:check": "node scripts/candidate-inventory.ts",
    "inventory:coverage": "node scripts/candidate-inventory.ts --coverage",
    "test:data": "node --test tests/catalog.test.ts tests/comparison.test.ts tests/manufacturer-sources.test.ts tests/candidate-inventory.test.ts",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "test": "pnpm run typecheck && pnpm run lint && pnpm run test:data && pnpm run build && pnpm run test:render && pnpm run test:browser",
    "check": "pnpm run test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.51.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.16.0"
}
