{
  "name": "product-compare-platform",
  "private": true,
  "description": "An evidence-led multi-app product lookup and comparison platform.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:phones": "pnpm --filter @product-compare/phones dev",
    "dev:tablets": "pnpm --filter @product-compare/tablets dev",
    "dev:cars": "pnpm --filter @product-compare/cars dev",
    "dev:laptops": "pnpm --filter @product-compare/laptops dev",
    "build": "pnpm --recursive --filter './apps/*' build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "pnpm --recursive --if-present lint",
    "test:data": "pnpm --recursive --if-present test:data",
    "check:workspace": "node --test tooling/*.test.mjs && node tooling/validate-workspaces.mjs",
    "check": "pnpm run check:workspace && pnpm --recursive --if-present check",
    "check:phones": "pnpm --filter @product-compare/phones check",
    "check:tablets": "pnpm --filter @product-compare/tablets check",
    "check:cars": "pnpm --filter @product-compare/cars check",
    "check:laptops": "pnpm --filter @product-compare/laptops check",
    "inventory:check": "pnpm --filter @product-compare/phones inventory:check",
    "inventory:coverage": "pnpm --filter @product-compare/phones inventory:coverage",
    "inventory:import:wikidata": "pnpm --filter @product-compare/phones inventory:import:wikidata"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.51.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.16.0"
}
